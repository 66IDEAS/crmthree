<% content_for :title, "Leaderboard · CRMthree" %>
<div class="page leaderboard-page"><header class="page-heading"><nav class="breadcrumb"><%= link_to "Home", root_path %> / Leaderboard</nav><div class="page-title-row"><div><h1 class="page-title">Leaderboard</h1><p class="page-subtitle">Celebrate progress across your visible team</p></div></div></header>
  <nav class="leaderboard-tabs" aria-label="Leaderboard dimension"><% Crm::Leaderboard::DIMENSIONS.each do |key, label| %><%= link_to label, leaderboard_path(dimension: key, period: @board.period), class: "button #{"is-current" if key == @board.dimension}" %><% end %></nav>
  <nav class="leaderboard-tabs" aria-label="Leaderboard period"><% Crm::Leaderboard::PERIODS.each do |period| %><%= link_to period.humanize, leaderboard_path(dimension: @board.dimension, period:), class: "button button--compact #{"is-current" if period == @board.period}" %><% end %></nav>
  <section class="panel leaderboard-table"><div class="table-scroll"><table class="data-table"><thead><tr><th>Rank</th><th>Person</th><th><%= Crm::Leaderboard::DIMENSIONS.fetch(@board.dimension) %></th><th>Trend</th></tr></thead><tbody><% @board.entries.each do |entry| %><tr class="<%= "is-current-user" if entry.current_user %> <%= "is-podium" if entry.rank <= 3 %>"><td><span class="rank-medal rank-medal--<%= entry.rank %>"><%= entry.rank %></span></td><td><% person = capture do %><span class="avatar"><%= entry.profile.first_name.first %><%= entry.profile.last_name.first %></span><strong><%= display_name(entry.profile) %></strong><% end %><% if policy(entry.profile).show? %><%= link_to person, member_profile_path(entry.profile), class: "leaderboard-person" %><% else %><span class="leaderboard-person"><%= person %></span><% end %></td><td><strong><%= number_with_delimiter(entry.value) %></strong></td><td aria-label="Rank trend"><%= entry.trend.positive? ? "↑" : (entry.trend.negative? ? "↓" : "—") %></td></tr><% end %></tbody></table></div></section>
</div>
