<% content_for :title, "Data import · CRMthree" %>
<div class="page" data-controller="import-progress" data-import-progress-url-value="<%= data_import_path(@import_run, format: :json) %>">
  <header class="page-heading"><nav class="breadcrumb"><%= link_to "Settings", settings_path %> / Data Import</nav><div class="page-title-row"><div><h1 class="page-title">Import <span data-import-progress-target="status"><%= @import_run.status.humanize %></span></h1><p class="page-subtitle"><%= @import_run.filename %></p></div></div></header>
  <section class="panel import-progress"><div class="panel__body"><progress max="100" value="<%= @import_run.progress_percent %>" data-import-progress-target="bar"></progress><p data-import-progress-target="summary"><%= @import_run.processed_rows %> / <%= @import_run.total_rows %> rows · <%= @import_run.created_count %> created · <%= @import_run.skipped_count %> skipped</p><% if @import_run.error_details.any? %><div class="form-errors"><strong>Rows requiring attention</strong><ul><% @import_run.error_details.each do |error| %><li><%= error["row"] ? "Row #{error["row"]}: " : "" %><%= error["message"] %></li><% end %></ul></div><% end %><%= link_to "Back to Settings", settings_path(anchor: "data-import"), class: "button" %></div></section>
</div>
