<% content_for :title, "#{@ticket.subject} · Case Room · CRMthree" %>
<div class="page workspace" data-controller="dialog workspace-live" data-workspace-live-type-value="Ticket" data-workspace-live-id-value="<%= @ticket.id %>" data-workspace-live-profile-value="<%= current_profile.id %>">
  <header class="page-heading workspace-header">
    <div class="workspace-header__title"><%= link_to case_rooms_path, class: "icon-button", aria: {label: "Back to Case Rooms"} do %><%= ui_icon "chevron-left", size: 22 %><% end %><div><h1 class="page-title"><%= @ticket.subject %></h1><span class="number-chip"><%= Ticket.crm_display_number(@ticket.ticket_number) %></span></div></div>
    <div class="record-actions"><span class="chip chip--<%= @ticket.status.is_closed? || @ticket.status.is_resolved? ? "positive" : "progress" %>"><%= @ticket.status.name %></span><span class="chip chip--<%= Crm::RecordPresentation.chip_tone(@ticket.priority_before_type_cast) %>"><%= @ticket.priority_before_type_cast %></span><%= link_to "View Ticket", record_path(object_type: "Ticket", id: @ticket.id), class: "button" %></div>
  </header>

  <%= render "briefings/card", object_type: "Ticket", record_id: @ticket.id %>

  <section class="panel quick-action-bar workspace-actions"><span class="quick-action-bar__label">Quick actions</span><%= form_with url: update_status_case_room_path(@ticket), method: :patch, class: "workspace-inline-action" do %><%= select_tag :status_id, options_from_collection_for_select(@statuses, :id, :name, @ticket.status_id), aria: {label: "Ticket status"} %><%= text_field_tag :resolution, nil, placeholder: "Resolution when required", aria: {label: "Resolution"} %><%= button_tag "Update Status", class: "button button--compact" %><% end %><button type="button" class="button button--compact" data-action="dialog#open" data-dialog-id-param="case-note-dialog"><%= ui_icon "message", size: 16 %> Add Note</button><button type="button" class="button button--compact" data-action="dialog#open" data-dialog-id-param="case-kb-dialog"><%= ui_icon "book", size: 16 %> Link KB Article</button></section>

  <div class="workspace-columns"><div class="workspace-main"><%= render "workspaces/activity_timeline", activities: @activities %><%= render "workspaces/comments", comments: @comments, workspace: @ticket %></div><aside class="workspace-sidebar">
    <section class="panel workspace-card"><div class="panel__header"><h2>Ticket Info</h2></div><dl class="workspace-facts"><dt>Status</dt><dd><%= @ticket.status.name %></dd><dt>Priority</dt><dd><%= @ticket.priority_before_type_cast %></dd><dt>Category</dt><dd><%= @ticket.category.presence || "—" %></dd><dt>Account</dt><dd><%= link_to @ticket.account.name1, record_path(object_type: "Account", id: @ticket.account_id), class: "record-link" %></dd><dt>Contact</dt><dd><%= @ticket.contact ? display_name(@ticket.contact) : "—" %></dd><dt>Response deadline</dt><dd><%= @ticket.sla_response_deadline ? l(@ticket.sla_response_deadline, format: :long) : "—" %></dd><dt>Resolution deadline</dt><dd><%= @ticket.sla_resolution_deadline ? l(@ticket.sla_resolution_deadline, format: :long) : "—" %></dd><dt>First response</dt><dd><%= @ticket.first_response_at ? l(@ticket.first_response_at, format: :long) : "—" %></dd><dt>Resolved</dt><dd><%= @ticket.resolved_at ? l(@ticket.resolved_at, format: :long) : "—" %></dd><dt>Owner</dt><dd><%= display_name(@ticket.owner) %></dd><dt>Assigned to</dt><dd><%= @ticket.assignee ? display_name(@ticket.assignee) : "Unassigned" %></dd></dl></section>
    <% if @ticket.asset %><section class="panel workspace-card"><div class="panel__header"><h2>Asset</h2></div><div class="workspace-spotlight"><%= ui_icon "wrench", size: 22 %><div><%= link_to @ticket.asset.name, record_path(object_type: "Asset", id: @ticket.asset_id), class: "record-link" %><small><%= @ticket.asset.serial_number %> · <%= @ticket.asset.status_before_type_cast %></small></div></div></section><% end %>
    <% if @ticket.service_contract %><section class="panel workspace-card"><div class="panel__header"><h2>Service Contract</h2></div><div class="workspace-spotlight"><%= ui_icon "shield", size: 22 %><div><%= link_to @ticket.service_contract.name, record_path(object_type: "ServiceContract", id: @ticket.service_contract_id), class: "record-link" %><small>Through <%= l(@ticket.service_contract.end_date, format: :long) %></small></div></div></section><% end %>
    <section class="panel workspace-card"><div class="panel__header"><h2>Knowledge Articles <span class="linked-count"><%= @knowledge_articles.length %></span></h2></div><div class="workspace-mini-list"><% @knowledge_articles.each do |link| %><%= link_to record_path(object_type: "KnowledgeArticle", id: link.article_id) do %><strong><%= link.article.title %></strong><small>Linked <%= time_ago_in_words(link.linked_at) %> ago</small><% end %><% end %><% if @knowledge_articles.empty? %><div class="empty-state">No knowledge articles linked.</div><% end %></div></section>
  </aside></div>

  <dialog id="case-note-dialog" class="dialog" data-dialog-target="dialog"><div class="dialog__header"><h2>Add Case Note</h2><button type="button" class="icon-button" data-action="dialog#close" aria-label="Close"><%= ui_icon "x", size: 18 %></button></div><%= form_with url: workspace_comments_path(workspace_type: "Ticket", workspace_id: @ticket.id) do %><div class="dialog__body field"><%= label_tag :content, "Note" %><%= text_area_tag :content, nil, required: true, rows: 6 %></div><div class="dialog__actions"><button type="button" class="button" data-action="dialog#close">Cancel</button><%= submit_tag "Post note", class: "button button--primary" %></div><% end %></dialog>
  <dialog id="case-kb-dialog" class="dialog" data-dialog-target="dialog"><div class="dialog__header"><h2>Link Knowledge Article</h2><button type="button" class="icon-button" data-action="dialog#close" aria-label="Close"><%= ui_icon "x", size: 18 %></button></div><%= form_with url: link_knowledge_case_room_path(@ticket) do %><div class="dialog__body field" data-controller="select-filter"><%= label_tag :knowledge_search, "Search published articles" %><%= search_field_tag :knowledge_search, nil, placeholder: "Start typing an article title…", autocomplete: "off", data: {select_filter_target: "query", action: "input->select-filter#filter"} %><%= label_tag :article_id, "Published article" %><%= select_tag :article_id, options_from_collection_for_select(@knowledge_options, :id, :title), required: true, data: {select_filter_target: "select"} %></div><div class="dialog__actions"><button type="button" class="button" data-action="dialog#close">Cancel</button><%= submit_tag "Link article", class: "button button--primary" %></div><% end %></dialog>
</div>
