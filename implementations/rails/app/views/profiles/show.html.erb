<% own_profile = @profile.id == current_profile.id %>
<% content_for :title, "#{display_name(@profile)} · Profile · CRMthree" %>
<div class="page profile-page">
  <header class="page-heading"><nav class="breadcrumb" aria-label="Breadcrumb"><%= link_to "Home", root_path %> / Profile / <%= display_name(@profile) %></nav><div class="page-title-row"><div class="profile-heading"><span class="avatar avatar--large"><%= @profile.first_name.first %><%= @profile.last_name.first %></span><div><h1 class="page-title"><%= display_name(@profile) %></h1><p class="page-subtitle"><%= @profile.role.name %> · <%= @profile.email %></p></div></div><div class="page-actions"><% if @manager %><%= link_to "View Team Timeline", team_timeline_path, class: "button" %><% end %><%= link_to "Export Portfolio", performance_portfolio_path(@profile, format: :csv), class: "button" %></div></div></header>

  <% if own_profile %><section class="panel profile-preferences"><div class="panel__header"><h2>Preferences</h2></div><div class="panel__body"><%= form_with model: @profile, url: profile_path, method: :patch, data: {controller: "autosubmit"} do |form| %><div class="form-grid"><div class="field"><%= form.label :theme_preference, crm_t("settings.theme", "Theme") %><%= form.select :theme_preference, [[crm_t("settings.light", "Light"), "Light"], [crm_t("settings.dark", "Dark"), "Dark"], [crm_t("settings.system", "Follow system"), "System"]], {}, data: {action: "theme#change"} %><span class="field-hint">The preview changes immediately and your selection is saved on this Mac.</span></div><div class="field"><%= form.label :language_preference, crm_t("profile.language", "Language") %><%= form.select :language_preference, Crm::TranslationService.options, {}, data: {action: "change->autosubmit#submit"} %></div></div><div class="form-actions"><%= form.submit crm_t("ui.save_changes", "Save preferences"), class: "button button--primary" %></div><% end %></div></section><% end %>

  <section class="profile-stat-grid" aria-label="Gamification statistics">
    <article class="panel profile-stat"><span><%= ui_icon "star", size: 20 %> Level</span><strong><%= @profile.level_name %></strong><small>Level <%= @profile.level %><% if @portfolio.next_level %> · <%= @portfolio.next_level.xp_threshold - @profile.xp_total %> XP to <%= @portfolio.next_level.name %><% end %></small><progress value="<%= @portfolio.progress_percent %>" max="100" aria-label="Level progress"><%= @portfolio.progress_percent %>%</progress></article>
    <article class="panel profile-stat"><span>XP Total</span><strong><%= number_with_delimiter(@profile.xp_total) %></strong><small>Lifetime experience</small></article>
    <article class="panel profile-stat"><span>Current Streak</span><strong>🔥 <%= @profile.current_streak_days %></strong><small>consecutive activity days</small></article>
    <article class="panel profile-stat"><span>Longest Streak</span><strong><%= @profile.longest_streak_days %></strong><small>personal record</small></article>
  </section>
  <% if own_profile && AIProviderConfig.exists?(is_active: true) %><%= turbo_frame_tag "performance_narrative_#{@profile.id}" do %><section class="panel ai-priority-card"><div class="ai-priority-card__icon"><%= ui_icon "spark", size: 22 %></div><div><h2>Performance narrative</h2><p>Generate a private summary from your authorised activity and outcome data.</p></div><%= button_to "Generate narrative", performance_briefing_path(profile_id: @profile.id), class: "button" %></section><% end %><% end %>

  <% unlocks = @portfolio.current_level&.unlocks.to_h.map { |name, value| value == true ? name.to_s.humanize : "#{name.to_s.humanize}: #{value}" } %><% if unlocks.present? %><section class="panel unlock-card"><div class="panel__header"><h2>Level Unlocks</h2></div><div class="panel__body"><%= unlocks.to_sentence %></div></section><% end %>

  <% challenge = @portfolio.active_challenge %><% if challenge %><section class="panel challenge-card"><div><span class="linked-card__eyebrow">Active monthly mission</span><h2><%= challenge.title %></h2><p><%= challenge.description %></p></div><div class="challenge-card__progress"><strong><%= challenge.current_value.to_i %> / <%= challenge.target_value.to_i %></strong><progress value="<%= challenge.current_value %>" max="<%= challenge.target_value %>"></progress><small><%= distance_of_time_in_words(Date.current, Date.new(challenge.year, challenge.month, -1)) %> remaining · Reward: <%= challenge.reward_xp %> XP<% if challenge.reward_badge %> + <%= challenge.reward_badge.name %><% end %></small></div></section><% elsif own_profile %><section class="panel challenge-card"><div><span class="linked-card__eyebrow">Monthly mission</span><h2>No mission assigned for this month</h2><p><%= AIProviderConfig.exists?(is_active: true) ? "Generate a personalised target from your authorised role and recent behaviour." : "Assign the standard local mission; configure AI for personalisation." %></p></div><%= button_to "Assign mission", challenge_assignment_path, params: {profile_id: @profile.id}, class: "button button--primary" %></section><% end %>

  <section class="panel trophy-case"><div class="panel__header"><div><span class="linked-card__eyebrow">Achievements</span><h2>Trophy Case</h2></div><span class="number-chip"><%= @portfolio.earned_badges.length %> earned</span></div><div class="trophy-grid"><% @portfolio.earned_badges.each do |earned| %><article class="trophy-card is-earned"><span class="trophy-card__icon"><%= ui_icon "medal", size: 25 %></span><span class="chip"><%= earned.badge.category_before_type_cast %></span><h3><%= earned.badge.name %></h3><p><%= earned.badge.description %></p><small>Earned <%= l(earned.earned_at.to_date, format: :long) %></small></article><% end %><% @portfolio.unearned_badges.each do |badge| %><article class="trophy-card is-locked"><span class="trophy-card__icon"><%= ui_icon "lock", size: 22 %></span><span class="chip"><%= badge.category_before_type_cast %></span><h3><%= badge.name %></h3><p><%= badge.description %></p><small>Not earned yet</small></article><% end %></div></section>

  <div class="portfolio-columns"><section class="panel"><div class="panel__header"><h2>Level Progression</h2></div><div class="portfolio-list"><% @portfolio.reached_levels.each do |level| %><div><span><strong>Level <%= level.level %> · <%= level.name %></strong><small><%= number_with_delimiter(level.xp_threshold) %> XP threshold</small></span><span><%= level.reached_at ? l(level.reached_at.to_date, format: :long) : "Reached" %></span></div><% end %></div></section><section class="panel"><div class="panel__header"><h2>Personal Bests</h2></div><div class="portfolio-list"><% @portfolio.personal_bests.each do |best| %><div><span><strong><%= best.metric.humanize %></strong><small><%= l(best.achieved_at.to_date, format: :long) %></small></span><b><%= number_with_delimiter(best.value) %></b></div><% end %><% if @portfolio.personal_bests.empty? %><div class="empty-state">No personal bests yet.</div><% end %></div></section></div>

  <section class="panel streak-history"><div class="panel__header"><h2>Streak History & Outcomes</h2></div><div class="portfolio-list"><% @portfolio.streaks.each do |streak| %><div><span><strong><%= streak.activity_type.humanize %></strong><small>Last activity <%= streak.last_activity_date || "—" %> · <%= @portfolio.streak_outcomes.fetch(streak) %></small></span><span><b><%= streak.current_count %></b> current · <b><%= streak.longest_count %></b> best</span></div><% end %><% if @portfolio.streaks.empty? %><div class="empty-state">No streak history yet.</div><% end %></div></section>

  <% if @portfolio.challenge_history.any? %><section class="panel"><div class="panel__header"><h2>Challenge History</h2></div><div class="portfolio-list"><% @portfolio.challenge_history.each do |item| %><div><span><strong><%= item.title %></strong><small><%= Date::MONTHNAMES[item.month] %> <%= item.year %></small></span><span class="chip chip--<%= Crm::RecordPresentation.chip_tone(item.status_before_type_cast) %>"><%= item.status_before_type_cast %></span></div><% end %></div></section><% end %>
</div>
