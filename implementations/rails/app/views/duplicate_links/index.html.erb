<% content_for :title, "Duplicates · CRMthree" %><div class="page"><header class="page-heading"><nav class="breadcrumb"><%= link_to "Home", root_path %> / Duplicates</nav><div class="page-title-row"><div><h1 class="page-title">Duplicate management</h1><p class="page-subtitle">Candidates stay visible until you review the evidence.</p></div><%= button_to "Analyze authorised records", analyze_duplicate_links_path, class: "button button--primary" %></div></header><section class="panel"><div class="table-scroll"><table class="data-table"><thead><tr><th>Type</th><th>Primary</th><th>Possible duplicate</th><th>Evidence</th><th>Status</th><th></th></tr></thead><tbody><% @links.each do |link| %><tr><td><%= link.object_type %></td><td><%= link_to display_name(link.primary_record), record_path(object_type: link.object_type, id: link.primary_record_id) %></td><td><%= link_to display_name(link.duplicate_record), record_path(object_type: link.object_type, id: link.duplicate_record_id) %></td><td><strong><%= link.confidence %>%</strong> · <%= link.reasons.to_a.to_sentence %></td><td><span class="chip <%= "chip--positive" if link.status_merged? %>"><%= link.status_before_type_cast %></span></td><td class="settings-actions"><% if link.status_potential? %><%= button_to "Merge", merge_duplicate_link_path(link), class: "button button--compact", form: {data: {turbo_confirm: "Merge into the proposed primary record? This can be reversed."}} %><%= button_to "Not duplicates", unlink_duplicate_link_path(link), class: "text-button" %><% elsif link.status_merged? %><%= button_to "Revert", revert_duplicate_link_path(link), class: "button button--compact" %><% end %></td></tr><% end %></tbody></table></div></section></div>
