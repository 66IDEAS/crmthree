<% content_for :title, "Review #{@draft.kind} · CRMthree" %>
<div class="page"><header class="page-heading"><nav class="breadcrumb"><%= link_to "Intake", intake_drafts_path %> / Review</nav><h1 class="page-title">Review <%= @draft.kind.underscore.humanize %></h1><p class="page-subtitle">Nothing is saved until you confirm.</p></header>
  <section class="panel"><div class="panel__header"><div><h2><%= @draft.object_type.presence || @draft.kind %> preview</h2><p><%= @draft.preview %></p></div><span class="chip"><%= @draft.metadata.to_h["state"] || @draft.status_before_type_cast %></span></div><% if @draft.status_draft? && @draft.metadata.to_h["state"] == "Ready" %><%= form_with url: apply_intake_draft_path(@draft), class: "settings-create__form" do %><div class="field"><%= label_tag :fields_json, "Reviewed CRM fields JSON" %><%= text_area_tag :fields_json, JSON.pretty_generate(@draft.extracted_data), rows: 16, required: true %></div><% if @draft.metadata.to_h["action_items"].present? %><div class="field"><strong>Reviewable action items</strong><pre><%= JSON.pretty_generate(@draft.metadata.to_h["action_items"]) %></pre><span class="field-hint">These will become planned tasks only after confirmation.</span></div><% end %><div class="form-actions"><%= submit_tag "Confirm and save", class: "button button--primary" %><%= link_to "Reject", reject_intake_draft_path(@draft), class: "button", data: {turbo_method: :post, turbo_confirm: "Reject this draft without changing CRM data?"} %></div><% end %><% elsif @draft.metadata.to_h["state"] == "Processing" %><div class="empty-state"><span class="spinner"></span> Processing in the local background queue. Refresh this page shortly.</div><% else %><div class="empty-state">This draft is not available for confirmation.</div><% end %></section>
</div>
