<% content_for :title, "Review Intake · CRMthree" %>
<div class="page"><header class="page-heading"><nav class="breadcrumb"><%= link_to "Home", root_path %> / Intake</nav><div class="page-title-row"><div><h1 class="page-title">Review-first intake</h1><p class="page-subtitle">Extract from a URL, card, profile, meeting, or email. CRM data changes only after your confirmation.</p></div></div></header>
  <% if AIProviderConfig.exists?(is_active: true) %><section class="panel"><div class="panel__header"><h2>New extraction</h2></div><%= form_with url: intake_drafts_path, multipart: true, class: "settings-create__form" do %><div class="form-grid"><div class="field"><%= label_tag :kind %><%= select_tag :kind, options_for_select(Crm::Intake::Extractor::KINDS) %></div><div class="field"><%= label_tag :source, "Source URL or label" %><%= text_field_tag :source, nil, placeholder: "https://… or Meeting with Northstar" %></div><div class="field"><%= label_tag :file, "Business card image (optional)" %><%= file_field_tag :file, accept: "image/*" %></div><div class="field"><%= label_tag :content, "Transcript, profile, or email content" %><%= text_area_tag :content, nil, rows: 6 %></div></div><%= submit_tag "Extract for review", class: "button button--primary" %><% end %></section><% else %><div class="empty-state">Configure an AI provider to use review-first intake.</div><% end %>
  <section class="panel"><div class="panel__header"><h2>Drafts</h2></div><div class="table-scroll"><table class="data-table"><thead><tr><th>Kind</th><th>Target</th><th>Preview</th><th>Status</th><th></th></tr></thead><tbody><% @drafts.each do |draft| %><tr><td><%= draft.kind %></td><td><%= draft.object_type %></td><td><%= truncate(draft.preview, length: 120) %></td><td><span class="chip <%= "chip--positive" if draft.status_applied? %>"><%= draft.status_before_type_cast %></span></td><td><%= link_to "Review", intake_draft_path(draft), class: "button button--compact" %></td></tr><% end %></tbody></table></div></section>
</div>
