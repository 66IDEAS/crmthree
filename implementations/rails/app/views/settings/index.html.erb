<% content_for :title, "Settings · CRMthree" %>

<div class="page settings-page">
  <header class="page-heading">
    <nav class="breadcrumb" aria-label="Breadcrumb"><%= link_to crm_t("nav.home", "Home"), root_path %> / <%= crm_t("nav.settings", "Settings") %></nav>
    <div class="page-title-row"><div><h1 class="page-title"><%= crm_t("nav.settings", "Settings") %></h1><p class="page-subtitle">Administration and personal application preferences</p></div></div>
  </header>

  <details class="panel settings-section" id="notification-preferences">
    <summary><span><%= ui_icon "bell", size: 18 %><strong><%= crm_t("settings.notifications.title", "Notification Preferences") %></strong></span><small><%= crm_t("settings.notifications.description", "Choose the events that should notify you") %></small></summary>
    <div class="settings-section__body">
      <%= form_with url: notification_preferences_path, method: :patch, data: {controller: "autosubmit notification-permission"} do %>
        <div class="preference-options preference-options--grid">
          <% Crm::NotificationPreferences::TYPES.each do |type, label| %>
            <% checked = Crm::NotificationPreferences.enabled?(current_profile, type) %>
            <label class="preference-option"><%= hidden_field_tag "preferences[#{type}]", "false", id: nil %><%= check_box_tag "preferences[#{type}]", "true", checked, data: {action: "change->autosubmit#submit"} %><span><%= label %></span></label>
          <% end %>
          <label class="preference-option preference-option--featured"><%= hidden_field_tag "preferences[desktop]", "false", id: nil %><%= check_box_tag "preferences[desktop]", "true", Crm::NotificationPreferences.desktop?(current_profile), data: {action: "change->notification-permission#request change->autosubmit#submit"} %><span>Desktop Notifications</span></label>
        </div>
        <noscript><%= submit_tag "Save preferences", class: "button button--primary" %></noscript>
      <% end %>
    </div>
  </details>

  <% if @admin %>
    <%= render "settings/phase_seven_integrations" %>
    <details class="panel settings-section" id="user-management">
      <summary><span><%= ui_icon "users", size: 18 %><strong>User Management</strong><span class="number-chip"><%= @users.length %></span><% pending = @users.count { |user| user.auth_uid.blank? } %><% if pending.positive? %><span class="chip chip--progress"><%= pending %> pending</span><% end %></span><small>Invite people and control their access</small></summary>
      <div class="settings-section__body">
        <p class="page-subtitle">Invite a colleague before their first sign-in, or create a local password identity immediately.</p>
        <details class="settings-create"><summary class="button button--primary"><%= ui_icon "plus", size: 16 %> Invite user</summary>
          <%= form_with url: users_path, scope: :user, class: "settings-create__form", data: {controller: "whitelist-warning", whitelist_warning_enabled_value: @access_rules.any?, whitelist_warning_emails_value: @access_rules.select(&:rule_type_email?).map(&:value).to_json, whitelist_warning_domains_value: @access_rules.select(&:rule_type_domain?).map(&:value).to_json} do |form| %><div class="form-grid">
            <div class="field"><%= form.label :email %><%= form.email_field :email, required: true, data: {whitelist_warning_target: "email", action: "input->whitelist-warning#update"} %><span class="field-hint field-hint--warning" data-whitelist-warning-target="warning" hidden>This address is not on the access whitelist and will be rejected at sign-in.</span></div>
            <div class="field"><%= form.label :role_id, "Role" %><%= form.select :role_id, @roles.select(&:active?).map { |role| [role.name, role.id] }, {selected: @roles.find { |role| role.name == "User" }&.id}, required: true %></div>
            <div class="field"><%= form.label :first_name %><%= form.text_field :first_name, required: true %></div>
            <div class="field"><%= form.label :last_name %><%= form.text_field :last_name, required: true %></div>
            <div class="field"><%= form.label :password, "Local password (optional)" %><%= form.password_field :password, minlength: 12, autocomplete: "new-password" %><span class="field-hint">Leave blank for a pending invitation; Google claiming is added in Phase 8.</span></div>
            <label class="preference-option"><%= form.check_box :add_to_whitelist, data: {whitelist_warning_target: "checkbox", action: "change->whitelist-warning#changed"} %><span>Add email to whitelist if needed</span></label>
          </div><div class="form-actions"><%= form.submit "Create access", class: "button button--primary" %></div><% end %>
        </details>
        <div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Name</th><th>Email</th><th>Role</th><th>Status</th><th>Level</th><th>Actions</th></tr></thead><tbody>
          <% @users.each do |user| %><% self_user = user.id == current_profile.id %><tr>
            <td><strong><%= display_name(user) %></strong> <% if self_user %><span class="chip">You</span><% end %></td><td><%= user.email %></td>
            <td><%= form_with url: user_path(user), method: :patch, data: {controller: "autosubmit"} do %><%= select_tag :role_id, options_from_collection_for_select(@roles.select(&:active?), :id, :name, user.role_id), disabled: self_user, data: {action: "change->autosubmit#submit"}, aria: {label: "Role for #{display_name(user)}"} %><% end %></td>
            <td><span class="chip <%= user.auth_uid.blank? ? "chip--progress" : (user.active? ? "chip--positive" : "") %>"><%= user.auth_uid.blank? ? "Pending" : (user.active? ? "Active" : "Inactive") %></span></td><td><%= user.level_name %> · <%= number_with_delimiter(user.xp_total) %> XP</td>
            <td class="settings-actions"><% unless self_user %><%= button_to(user.active? ? "Deactivate" : "Reactivate", user_path(user), method: :patch, params: {active: !user.active?}, class: "text-button") %><button type="button" class="text-button" data-controller="clipboard" data-clipboard-text-value="Sign in to CRMTHREE at http://localhost:3000 using <%= user.email %>. Contact your administrator if you need a local password." data-action="clipboard#copy">Copy instructions</button><%= button_to "Delete", user_path(user), method: :delete, class: "text-button text-button--danger", form: {data: {turbo_confirm: "Delete #{display_name(user)}? Their CRM records will be retained."}} %><% else %><span class="page-subtitle">Protected</span><% end %></td>
          </tr><% end %>
        </tbody></table></div>
      </div>
    </details>

    <details class="panel settings-section" id="list-sorting">
      <summary><span><%= ui_icon "list", size: 18 %><strong><%= crm_t("settings.list_sort.title", "List Sorting") %></strong></span><small><%= crm_t("settings.list_sort.description", "Choose the order in which each list opens") %></small></summary>
      <div class="settings-section__body"><h2 class="sr-only">Default list sorting</h2><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Object</th><th>Sort By</th><th>Direction</th><th>Sorted Field</th><th>Data Health</th></tr></thead><tbody>
        <% @sort_rows.each do |row| %><tr><td><strong><%= object_label(row.object_type, count: 2) %></strong></td><td colspan="4"><%= form_with model: ListSortSetting.new(sort_by: row.sort_by, direction: row.direction), url: list_sort_setting_path(object_type: row.object_type), method: :patch, class: "settings-row-form", data: {controller: "autosubmit"} do |form| %><%= form.select :sort_by, [["Number", "Number"], ["Name", "Name"]], {}, data: {action: "change->autosubmit#submit"}, aria: {label: "Sort #{row.object_type} by"} %><%= form.select :direction, [["Ascending", "Asc"], ["Descending", "Desc"]], {}, data: {action: "change->autosubmit#submit"}, aria: {label: "Direction for #{row.object_type}"} %><code><%= row.field.humanize %></code><% if row.missing_count.positive? %><span class="chip chip--progress" title="Records are missing the configured number"><%= row.missing_count %> hidden</span><%= link_to "Fix", repair_list_sort_setting_path(object_type: row.object_type), class: "text-button", data: {turbo_method: :post} %><% else %><span class="chip chip--positive">Complete</span><% end %><noscript><%= form.submit "Save" %></noscript><% end %></td></tr><% end %>
      </tbody></table></div></div>
    </details>

    <details class="panel settings-section" id="role-management">
      <summary><span><%= ui_icon "shield", size: 18 %><strong>Role Management</strong></span><small>Configure action permissions and Ribbon navigation</small></summary>
      <div class="settings-section__body"><details class="settings-create"><summary class="button button--primary"><%= ui_icon "plus", size: 16 %> Add custom role</summary><%= form_with url: roles_path, scope: :role, class: "settings-create__form" do |form| %><div class="form-grid"><div class="field"><%= form.label :name %><%= form.text_field :name, required: true %></div><div class="field"><%= form.label :description %><%= form.text_field :description %></div></div><%= form.submit "Create role", class: "button button--primary" %><% end %></details>
        <div class="role-list"><% @roles.each do |role| %><details class="role-editor"><summary><span><strong><%= role.name %></strong><span class="chip <%= "chip--positive" if role.is_system_role? %>"><%= role.is_system_role? ? "System" : "Custom" %></span></span><small><%= role.description %></small></summary><%= form_with model: role, url: role_path(role), method: :patch do |form| %><div class="form-grid"><div class="field"><%= form.label :name %><%= form.text_field :name, readonly: role.is_system_role? %></div><div class="field"><%= form.label :description %><%= form.text_field :description, readonly: role.is_system_role? %></div></div>
          <h3>Ribbon items</h3><div class="preference-options preference-options--grid"><% Crm::Navigation::ENTRIES.each do |entry| %><label class="preference-option"><%= check_box_tag "role[ribbon_items][]", entry.key, role.ribbon_items.include?("*") || role.ribbon_items.include?(entry.key) || role.ribbon_items.include?(entry.group) %><span><%= entry.label %></span></label><% end %></div>
          <h3>Action permissions</h3><div class="table-scroll"><table class="data-table permission-table"><thead><tr><th>Object</th><% ApplicationPolicy::ACTIONS.each do |action| %><th><%= action.humanize %></th><% end %></tr></thead><tbody><% Crm::ModelRegistry.navigable_object_names.each do |object_type| %><tr><td><strong><%= object_label(object_type, count: 2) %></strong></td><% ApplicationPolicy::ACTIONS.each do |action| %><% checked = role.permissions.dig(object_type, action) == true || role.permissions.dig("*", action) == true %><td><%= check_box_tag "role[permissions][#{object_type}][#{action}]", "true", checked, aria: {label: "#{action.humanize} #{object_type}"} %></td><% end %></tr><% end %></tbody></table></div><h3>Advanced role-adaptive layout</h3><div class="form-grid"><div class="field"><%= label_tag "role_visible_cards_#{role.id}", "Visible cards JSON" %><%= text_area_tag "role[visible_cards]", JSON.pretty_generate(role.visible_cards), id: "role_visible_cards_#{role.id}", readonly: role.is_system_role? %></div><div class="field"><%= label_tag "role_layout_config_#{role.id}", "Layout configuration JSON" %><%= text_area_tag "role[layout_config]", JSON.pretty_generate(role.layout_config), id: "role_layout_config_#{role.id}", readonly: role.is_system_role? %></div></div><div class="form-actions"><%= form.submit "Save role", class: "button button--primary" %><% unless role.is_system_role? %><%= link_to "Delete role", role_path(role), class: "text-button text-button--danger", data: {turbo_method: :delete, turbo_confirm: "Delete #{role.name}?"} %><% end %></div><% end %></details><% end %></div>
      </div>
    </details>

    <details class="panel settings-section" id="gamification">
      <summary><span><%= ui_icon "trophy", size: 18 %><strong>Gamification</strong></span><small>XP events, levels, badges, and progression</small></summary>
      <div class="settings-section__body">
        <div class="panel__header"><div><h2>Motivation Engine</h2><p class="page-subtitle">Changes apply to the next qualifying domain event.</p></div><%= button_to "Initialize Defaults", initialize_gamification_path, class: "button" %></div>
        <h3>XP Events</h3><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Event</th><th>Description</th><th>XP</th><th>Active</th><th></th></tr></thead><tbody><% @xp_events.each do |event| %><tr><td colspan="5"><%= form_with url: gamification_setting_path(object_type: "XPEvent", id: event.id), method: :patch, scope: :setting, class: "gamification-row-form gamification-row-form--xp" do |form| %><code><%= event.event_type %></code><%= form.text_field :description, value: event.description, required: true, aria: {label: "Description for #{event.event_type}"} %><%= form.number_field :xp_value, value: event.xp_value, required: true, min: 0, aria: {label: "XP for #{event.event_type}"} %><label class="checkbox-field"><%= form.check_box :active, checked: event.active? %><span>Active</span></label><%= form.submit "Save", class: "button button--compact" %><% end %></td></tr><% end %></tbody></table></div>
        <h3>Level Definitions</h3><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Level</th><th>Name</th><th>XP Threshold</th><th>Unlocks JSON</th><th></th></tr></thead><tbody><% @level_definitions.each do |level| %><tr><td colspan="5"><%= form_with url: gamification_setting_path(object_type: "LevelDefinition", id: level.id), method: :patch, scope: :setting, class: "gamification-row-form" do |form| %><strong><%= level.level %></strong><%= form.text_field :name, value: level.name, required: true, aria: {label: "Name for level #{level.level}"} %><%= form.number_field :xp_threshold, value: level.xp_threshold, required: true, min: 0, aria: {label: "XP threshold for level #{level.level}"} %><%= form.text_field :unlocks, value: JSON.generate(level.unlocks || {}), aria: {label: "Unlocks JSON for level #{level.level}"} %><%= form.submit "Save", class: "button button--compact" %><% end %></td></tr><% end %></tbody></table></div>
        <div class="panel__header"><h3>Badges</h3><%= link_to new_record_path(object_type: "Badge", return_to: settings_path(anchor: "gamification")), class: "button button--primary" do %><%= ui_icon "plus", size: 16 %> Add Custom Badge<% end %></div><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Name</th><th>Category</th><th>Description</th><th>Criteria JSON</th><th>Active</th><th></th></tr></thead><tbody><% @badges.each do |badge| %><tr><td colspan="6"><%= form_with url: gamification_setting_path(object_type: "Badge", id: badge.id), method: :patch, scope: :setting, class: "gamification-row-form gamification-row-form--badge" do |form| %><%= form.text_field :name, value: badge.name, required: true, aria: {label: "Badge name"} %><%= form.select :category, Badge.categories.keys.map { |value| [value, value] }, {selected: badge.category_before_type_cast}, aria: {label: "Category for #{badge.name}"} %><%= form.text_field :description, value: badge.description, required: true, aria: {label: "Description for #{badge.name}"} %><%= form.text_field :criteria, value: JSON.generate(badge.criteria), aria: {label: "Criteria JSON for #{badge.name}"} %><label class="checkbox-field"><%= form.check_box :active, checked: badge.active? %><span>Active</span></label><%= form.submit "Save", class: "button button--compact" %><% end %></td></tr><% end %></tbody></table></div>
      </div>
    </details>

    <details class="panel settings-section" id="access-control">
      <summary><span><%= ui_icon "lock", size: 18 %><strong><%= crm_t("settings.access.title", "Access Control") %></strong></span><small>Email and domain whitelist</small></summary><div class="settings-section__body"><p class="page-subtitle"><%= crm_t("settings.access.description", "An empty list allows every authenticated email. Once a rule exists, only exact emails or matching domains are accepted.") %></p><%= form_with model: EmailAccessRule.new, class: "settings-inline-form" do |form| %><%= form.select :rule_type, [[crm_t("settings.access.email", "Email"), "Email"], [crm_t("settings.access.domain", "Domain"), "Domain"]] %><%= form.text_field :value, required: true, placeholder: "person@example.com or example.com" %><%= form.submit crm_t("ui.add", "Add"), class: "button button--primary" %><% end %><div class="access-rule-list"><% if @access_rules.empty? %><em><%= crm_t("settings.access.empty", "No access restrictions are configured.") %></em><% end %><% @access_rules.each do |rule| %><span class="access-rule"><span class="chip"><%= rule.rule_type.humanize %></span><strong><%= rule.value %></strong><%= button_to crm_t("ui.remove", "Remove"), email_access_rule_path(rule), method: :delete, class: "text-button text-button--danger" %></span><% end %></div></div>
    </details>

    <details class="panel settings-section" id="data-import">
      <summary><span><%= ui_icon "upload", size: 18 %><strong><%= crm_t("settings.import.title", "Data Import") %></strong></span><small><%= crm_t("settings.import.description", "Preview and map a CSV before creating records") %></small></summary><div class="settings-section__body"><%= form_with url: preview_data_import_path, multipart: true, class: "settings-inline-form", data: {turbo: false} do %><%= select_tag :object_type, options_for_select(Crm::ModelRegistry.navigable_object_names.map { |name| [object_label(name, count: 2), name] }), required: true, aria: {label: "Target object"} %><%= file_field_tag :file, accept: ".csv,text/csv", required: true %><%= submit_tag "Preview import", class: "button button--primary" %><% end %><p class="field-hint">Files stay on this Mac, are limited to 5 MB, and are removed from the import run after processing.</p></div>
    </details>

    <details class="panel settings-section" id="language-management">
      <summary><span><%= ui_icon "globe", size: 18 %><strong><%= crm_t("settings.language.title", "Language Management") %></strong></span><small><%= crm_t("settings.language.description", "Manage the bundled label catalog") %></small></summary><div class="settings-section__body"><%= form_with model: Translation.new, class: "settings-inline-form" do |form| %><%= form.text_field :language_name, required: true, placeholder: "Language name" %><%= form.text_field :language_code, required: true, maxlength: 5, placeholder: "ISO code" %><%= form.submit crm_t("settings.language.add", "Add language"), class: "button button--primary" %><% end %><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Language</th><th>Code</th><th>Labels Translated</th><th><%= crm_t("ui.actions", "Actions") %></th></tr></thead><tbody><% @translations.each do |translation| %><tr><td><strong><%= translation.language_name %></strong></td><td><code><%= translation.language_code %></code></td><td><%= Crm::TranslationService.translated_count(translation) %> / <%= Crm::LabelCatalog.all.length %></td><td class="settings-actions"><%= link_to crm_t("settings.language.manage", "Manage"), edit_translation_path(translation), class: "button button--compact" %><%= button_to crm_t("ui.delete", "Delete"), translation_path(translation), method: :delete, class: "text-button text-button--danger", form: {data: {turbo_confirm: "Delete #{translation.language_name}?"}} %></td></tr><% end %></tbody></table></div></div>
    </details>

    <details class="panel settings-section" id="pipeline-stages"><summary><span><%= ui_icon "target", size: 18 %><strong>Pipeline Stages</strong></span><small>Sales sequence and outcomes</small></summary><div class="settings-section__body"><h2 class="sr-only">Pipeline stages</h2><div class="panel__header"><span></span><%= link_to new_record_path(object_type: "PipelineStage", return_to: settings_path), class: "button button--primary" do %><%= ui_icon "plus", size: 16 %> Add stage<% end %></div><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Order</th><th>Stage</th><th>Probability</th><th>Outcome</th><th>Status</th><th>Actions</th></tr></thead><tbody><% @pipeline_stages.each do |stage| %><tr><td><%= stage.sort_order %></td><td><strong><%= stage.name %></strong></td><td><%= stage.default_probability %>%</td><td><%= stage.is_closed? ? (stage.is_won? ? "Won" : "Lost") : "Open" %></td><td><%= stage.active? ? "Active" : "Inactive" %></td><td><%= link_to "Edit", edit_record_path(object_type: "PipelineStage", id: stage.id, return_to: settings_path), class: "button button--compact" %></td></tr><% end %></tbody></table></div></div></details>

    <details class="panel settings-section" id="ticket-statuses"><summary><span><%= ui_icon "lifebuoy", size: 18 %><strong>Ticket Statuses</strong></span><small>Service lifecycle configuration</small></summary><div class="settings-section__body"><h2 class="sr-only">Ticket statuses</h2><div class="panel__header"><span></span><%= link_to new_record_path(object_type: "TicketStatus", return_to: settings_path), class: "button button--primary" do %><%= ui_icon "plus", size: 16 %> Add status<% end %></div><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Order</th><th>Status</th><th>Resolved</th><th>Closed</th><th>Active</th><th>Actions</th></tr></thead><tbody><% @ticket_statuses.each do |status| %><tr><td><%= status.sort_order %></td><td><strong><%= status.name %></strong></td><td><%= status.is_resolved? ? "Yes" : "No" %></td><td><%= status.is_closed? ? "Yes" : "No" %></td><td><%= status.active? ? "Active" : "Inactive" %></td><td class="settings-actions"><%= link_to "Edit", edit_record_path(object_type: "TicketStatus", id: status.id, return_to: settings_path), class: "button button--compact" %><%= button_to "Delete", record_path(object_type: "TicketStatus", id: status.id), method: :delete, class: "text-button text-button--danger" %></td></tr><% end %></tbody></table></div></div></details>

    <details class="panel settings-section" id="service-levels"><summary><span><%= ui_icon "clock", size: 18 %><strong>Service Level Agreements</strong></span><small>Response and resolution targets</small></summary><div class="settings-section__body"><h2 class="sr-only">Service level agreements</h2><div class="panel__header"><span></span><%= link_to new_record_path(object_type: "SLA", return_to: settings_path), class: "button button--primary" do %><%= ui_icon "plus", size: 16 %> Add SLA<% end %></div><div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>SLA</th><th>Priorities</th><th>Response</th><th>Resolution</th><th>Clock</th><th>Status</th><th>Actions</th></tr></thead><tbody><% @slas.each do |sla| %><tr><td><strong><%= sla.name %></strong></td><td><%= Array(sla.applies_to_priorities).compact_blank.to_sentence.presence || "All" %></td><td><%= sla.response_time_hours %> h</td><td><%= sla.resolution_time_hours %> h</td><td><%= sla.business_hours_only? ? "Business hours" : "Continuous" %></td><td><%= sla.active? ? "Active" : "Inactive" %></td><td><%= link_to "Edit", edit_record_path(object_type: "SLA", id: sla.id, return_to: settings_path), class: "button button--compact" %></td></tr><% end %></tbody></table></div></div></details>
  <% end %>
</div>
