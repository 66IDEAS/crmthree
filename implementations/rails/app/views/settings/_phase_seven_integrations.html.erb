<details class="panel settings-section" id="ai-providers">
  <summary><span><%= ui_icon "spark", size: 18 %><strong>AI Providers</strong><span class="number-chip"><%= @ai_provider_configs.length %></span></span><small>Encrypted, single-active provider configuration</small></summary>
  <div class="settings-section__body">
    <p class="field-hint">Keys are encrypted on this Mac and are never displayed again. Leave a saved key blank when changing another setting.</p>
    <details class="settings-create"><summary class="button button--primary">Add provider</summary>
      <%= form_with model: AIProviderConfig.new, class: "settings-create__form" do |form| %><div class="form-grid">
        <div class="field"><%= form.label :provider %><%= form.select :provider, AIProviderConfig.providers.keys.map { |key| [key, AIProviderConfig.providers[key]] } %></div>
        <div class="field"><%= form.label :model %><%= form.text_field :model, required: true %></div>
        <div class="field"><%= form.label :api_key %><%= form.password_field :api_key, required: true, autocomplete: "off" %></div>
        <div class="field"><%= form.label :endpoint_url, "Custom endpoint (optional)" %><%= form.url_field :endpoint_url %></div>
        <label class="checkbox-field"><%= form.check_box :is_active %><span>Activate this provider</span></label>
      </div><%= form.submit "Save provider", class: "button button--primary" %><% end %>
    </details>
    <div class="role-list"><% @ai_provider_configs.each do |config| %><details class="role-editor"><summary><span><strong><%= config.provider_before_type_cast %></strong><span class="chip <%= "chip--positive" if config.is_active? %>"><%= config.is_active? ? "Active" : "Inactive" %></span></span><small><%= config.model %></small></summary>
      <%= form_with model: config, class: "settings-create__form" do |form| %><div class="form-grid"><div class="field"><%= form.label :model %><%= form.text_field :model, required: true %></div><div class="field"><%= form.label :api_key, "Replacement key (optional)" %><%= form.password_field :api_key, value: "", autocomplete: "off" %></div><div class="field"><%= form.label :endpoint_url %><%= form.url_field :endpoint_url %></div><label class="checkbox-field"><%= form.check_box :is_active %><span>Active</span></label></div><div class="form-actions"><%= form.submit "Update", class: "button" %><%= button_to "Remove", ai_provider_config_path(config), method: :delete, class: "text-button text-button--danger", form: {data: {turbo_confirm: "Remove this provider?"}} %></div><% end %>
    </details><% end %></div>
  </div>
</details>

<details class="panel settings-section" id="data-sources">
  <summary><span><%= ui_icon "database", size: 18 %><strong>Data Sources</strong><span class="number-chip"><%= @data_source_configs.length %></span></span><small>Route an object to local PostgreSQL or a REST endpoint</small></summary>
  <div class="settings-section__body">
    <details class="settings-create"><summary class="button button--primary">Add data source</summary>
      <%= form_with model: DataSourceConfig.new, class: "settings-create__form" do |form| %><div class="form-grid"><div class="field"><%= form.label :object_type %><%= form.select :object_type, Crm::ModelRegistry.navigable_object_names %></div><div class="field"><%= form.label :source_type %><%= form.select :source_type, [["Local", "Local"], ["External", "External"]] %></div><div class="field"><%= form.label :endpoint_url %><%= form.url_field :endpoint_url %></div><div class="field"><%= form.label :auth_type %><%= form.select :auth_type, [["None", "None"], ["Basic", "BasicAuth"], ["OAuth token", "OAuth2"], ["API key", "APIKey"]] %></div><div class="field"><%= form.label :auth_config, "Credentials JSON" %><%= form.password_field :auth_config, autocomplete: "off", placeholder: '{"api_key":"…"}' %></div><div class="field"><%= form.label :field_mapping, "External → CRM mapping JSON" %><%= form.text_area :field_mapping, value: "{}" %></div><label class="checkbox-field"><%= form.check_box :active, checked: true %><span>Active</span></label></div><%= form.submit "Save data source", class: "button button--primary" %><% end %>
    </details>
    <div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Object</th><th>Source</th><th>Endpoint</th><th>Status</th><th></th></tr></thead><tbody><% @data_source_configs.each do |config| %><tr><td><strong><%= config.object_type %></strong></td><td><%= config.source_type_before_type_cast %></td><td><%= config.endpoint_url.presence || "This Mac" %></td><td><span class="chip <%= "chip--positive" if config.active? %>"><%= config.active? ? "Active" : "Inactive" %></span></td><td><%= button_to "Remove", data_source_config_path(config), method: :delete, class: "text-button text-button--danger" %></td></tr><% end %></tbody></table></div>
  </div>
</details>

<details class="panel settings-section" id="replication">
  <summary><span><%= ui_icon "refresh", size: 18 %><strong>Data Replication</strong><span class="number-chip"><%= @replication_configs.length %></span></span><small>Idempotent imports with run summaries</small></summary>
  <div class="settings-section__body">
    <details class="settings-create"><summary class="button button--primary">Add replication source</summary>
      <%= form_with model: ReplicationConfig.new, class: "settings-create__form" do |form| %><div class="form-grid"><div class="field"><%= form.label :object_type %><%= form.select :object_type, Crm::ModelRegistry.navigable_object_names %></div><div class="field"><%= form.label :endpoint_url %><%= form.url_field :endpoint_url, required: true %></div><div class="field"><%= form.label :key_field, "CRM match key" %><%= form.text_field :key_field, required: true %></div><div class="field"><%= form.label :source_key_field %><%= form.text_field :source_key_field %></div><div class="field"><%= form.label :delete_flag_field %><%= form.text_field :delete_flag_field %></div><div class="field"><%= form.label :request_body, "Request body JSON" %><%= form.text_area :request_body, value: "{}" %></div><div class="field"><%= form.label :field_mapping, "Source → CRM mapping JSON" %><%= form.text_area :field_mapping, value: "{}" %></div><div class="field"><%= form.label :auth_config, "Credentials JSON" %><%= form.password_field :auth_config, autocomplete: "off" %></div></div><%= form.submit "Save source", class: "button button--primary" %><% end %>
    </details>
    <div class="table-scroll"><table class="data-table settings-table"><thead><tr><th>Object</th><th>Match</th><th>Last run</th><th>Summary</th><th></th></tr></thead><tbody><% @replication_configs.each do |config| %><% run = config.replication_runs.max_by(&:created_at) %><tr><td><strong><%= config.object_type %></strong><small><%= config.endpoint_url %></small></td><td><%= config.source_key_field.presence || config.key_field %> → <%= config.key_field %></td><td><%= config.last_run_at ? l(config.last_run_at, format: :short) : "Never" %></td><td><% if run %><span class="chip <%= "chip--positive" if run.status_completed? %>"><%= run.status_before_type_cast %></span> <%= run.created_count %> created · <%= run.updated_count %> updated · <%= run.skipped_count %> skipped · <%= run.error_count %> errors<% else %>—<% end %></td><td class="settings-actions"><%= button_to "Run", run_replication_config_path(config), class: "button button--compact", params: {idempotency_key: SecureRandom.uuid} %><%= button_to "Remove", replication_config_path(config), method: :delete, class: "text-button text-button--danger" %></td></tr><% end %></tbody></table></div>
  </div>
</details>

<details class="panel settings-section" id="ai-proposals">
  <summary><span><%= ui_icon "spark", size: 18 %><strong>AI Change Proposals</strong><span class="number-chip"><%= @configuration_proposals.length %></span></span><small>Preview, approve, version, or reverse constrained changes</small></summary>
  <div class="settings-section__body">
    <p class="field-hint">Drafts are inert JSON. AI output is never evaluated as Ruby, SQL, shell, or templates, and nothing is applied until you approve it.</p>
    <% if AIProviderConfig.exists?(is_active: true) %><%= form_with url: configuration_proposals_path, class: "settings-create__form" do %><div class="form-grid"><div class="field"><%= label_tag :kind %><%= select_tag :kind, options_for_select(["Configuration", "Feature"]) %></div><div class="field"><%= label_tag :prompt, "Requested change" %><%= text_area_tag :prompt, nil, required: true, maxlength: 5000, placeholder: "Add an optional customer tier field and place it below Industry…" %></div></div><%= submit_tag "Draft proposal", class: "button button--primary" %><% end %><% end %>
    <div class="role-list"><% @configuration_proposals.each do |proposal| %><details class="role-editor"><summary><span><strong><%= proposal.kind_before_type_cast %> v<%= proposal.version %></strong><span class="chip <%= "chip--positive" if proposal.status_approved? %>"><%= proposal.status_before_type_cast %></span></span><small><%= truncate(proposal.prompt, length: 100) %></small></summary><div class="settings-create__form"><p><%= proposal.preview %></p><pre><%= JSON.pretty_generate(proposal.proposed_changes) %></pre><div class="form-actions"><% if proposal.status_draft? %><%= button_to "Approve and apply", approve_configuration_proposal_path(proposal), class: "button button--primary", form: {data: {turbo_confirm: "Apply this reviewed, constrained change?"}} %><%= button_to "Reject", configuration_proposal_path(proposal), method: :delete, class: "text-button text-button--danger" %><% elsif proposal.status_approved? %><%= button_to "Rollback", rollback_configuration_proposal_path(proposal), class: "button", form: {data: {turbo_confirm: "Restore the previous configuration version?"}} %><% end %></div></div></details><% end %></div>
  </div>
</details>
