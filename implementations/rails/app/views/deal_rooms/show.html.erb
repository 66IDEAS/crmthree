<% opportunity = @opportunity %>
<% content_for :title, "#{@deal_room.name} · CRMthree" %>
<div class="page workspace" data-controller="dialog workspace-live" data-workspace-live-type-value="DealRoom" data-workspace-live-id-value="<%= @deal_room.id %>" data-workspace-live-profile-value="<%= current_profile.id %>">
  <header class="page-heading workspace-header">
    <div class="workspace-header__title"><%= link_to deal_rooms_path, class: "icon-button", aria: {label: "Back to Deal Rooms"} do %><%= ui_icon "chevron-left", size: 22 %><% end %><div><h1 class="page-title"><%= @deal_room.name %></h1><span class="number-chip"><%= DealRoom.crm_display_number(@deal_room.deal_room_number) %></span></div></div>
    <div class="record-actions"><span class="chip chip--<%= @deal_room.status_active? ? "positive" : "neutral" %>"><%= @deal_room.status_before_type_cast %></span><%= link_to "View Opportunity", record_path(object_type: "Opportunity", id: opportunity.id), class: "button" %><% if @deal_room.status_active? %><%= button_to close_deal_room_path(@deal_room), method: :patch, class: "button button--danger", form: {data: {turbo_confirm: "Close this Deal Room?"}} do %><%= ui_icon "lock", size: 16 %> Close Deal Room<% end %><% end %></div>
  </header>

  <%= render "briefings/card", object_type: "Opportunity", record_id: opportunity.id %>
  <% if AIProviderConfig.exists?(is_active: true) %><%= turbo_frame_tag "pipeline_coaching_#{opportunity.id}" do %><section class="panel ai-priority-card"><div class="ai-priority-card__icon"><%= ui_icon "spark", size: 22 %></div><div><h2>Pipeline coaching</h2><p>Generate stage-specific advice grounded in authorised company history.</p></div><%= button_to "Coach this deal", coaching_briefing_path(opportunity_id: opportunity.id), class: "button button--primary" %></section><% end %><% end %>

  <section class="panel quick-action-bar workspace-actions"><span class="quick-action-bar__label">Quick actions</span><% if @deal_room.status_active? %><%= form_with url: update_stage_deal_room_path(@deal_room), method: :patch, class: "workspace-inline-action" do %><%= select_tag :stage_id, options_from_collection_for_select(@stages, :id, :name, opportunity.stage_id), aria: {label: "Deal stage"} %><%= button_tag "Update Stage", class: "button button--compact" %><% end %><button type="button" class="button button--compact" data-action="dialog#open" data-dialog-id-param="deal-note-dialog"><%= ui_icon "message", size: 16 %> Add Note</button><%= link_to new_record_path(object_type: "Activity", activity_type: "Task", parent_field: "opportunity_id", parent_id: opportunity.id, context_label: opportunity.name, return_to: deal_room_path(@deal_room)), class: "button button--compact" do %><%= ui_icon "calendar", size: 16 %> Schedule Follow-up<% end %><% end %></section>

  <section class="panel stage-progress-card"><div class="panel__header"><h2>Deal Stage Progress</h2></div><ol class="stage-progress"><% @stages.each do |stage| %><% passed = stage.sort_order <= opportunity.stage.sort_order %><% current = stage.id == opportunity.stage_id %><li class="<%= "is-complete" if passed %> <%= "is-current" if current %> <%= "is-lost" if current && opportunity.result_lost? %>"><span><%= passed && !current ? "✓" : stage.sort_order / 10 %></span><strong><%= stage.name %></strong></li><% end %></ol></section>

  <div class="workspace-columns"><div class="workspace-main"><%= render "workspaces/activity_timeline", activities: @activities %><%= render "workspaces/comments", comments: @comments, workspace: @deal_room %></div><aside class="workspace-sidebar">
    <section class="panel workspace-card"><div class="panel__header"><h2>Deal Info</h2></div><dl class="workspace-facts"><dt>Amount</dt><dd><%= number_to_currency(opportunity.amount, unit: "#{opportunity.currency} ", strip_insignificant_zeros: true) %></dd><dt>Probability</dt><dd><%= opportunity.probability %>%</dd><dt>Expected close</dt><dd><%= opportunity.expected_close_date ? l(opportunity.expected_close_date, format: :long) : "—" %></dd><dt>Result</dt><dd><span class="chip chip--<%= Crm::RecordPresentation.chip_tone(opportunity.result_before_type_cast) %>"><%= opportunity.result_before_type_cast %></span></dd><dt>Stage</dt><dd><%= opportunity.stage.name %></dd><dt>Owner</dt><dd><%= display_name(opportunity.owner) %></dd><dt>Account</dt><dd><%= link_to opportunity.account.name1, record_path(object_type: "Account", id: opportunity.account_id), class: "record-link" %></dd></dl></section>
    <section class="panel workspace-card"><div class="panel__header"><h2>Contacts with Roles <span class="linked-count"><%= @contacts.length %></span></h2></div><div class="workspace-mini-list"><% @contacts.each do |link| %><%= link_to record_path(object_type: "Contact", id: link.contact_id) do %><strong><%= display_name(link.contact) %></strong><small><%= link.role.presence || "Stakeholder" %></small><% end %><% end %><% if @contacts.empty? %><div class="empty-state">No contacts linked.</div><% end %></div></section>
    <section class="panel workspace-card"><div class="panel__header"><h2>Documents <span class="linked-count"><%= @documents.length %></span></h2></div><div class="workspace-mini-list"><% @documents.each do |document| %><%= link_to record_path(object_type: "Document", id: document.id) do %><strong><%= document.name %></strong><small><%= number_to_human_size(document.file_size) if document.file_size %></small><% end %><% end %><% if @documents.empty? %><div class="empty-state">No documents attached.</div><% end %></div></section>
  </aside></div>

  <dialog id="deal-note-dialog" class="dialog" data-dialog-target="dialog"><div class="dialog__header"><h2>Add Deal Note</h2><button type="button" class="icon-button" data-action="dialog#close" aria-label="Close"><%= ui_icon "x", size: 18 %></button></div><%= form_with url: workspace_comments_path(workspace_type: "DealRoom", workspace_id: @deal_room.id) do %><div class="dialog__body field"><%= label_tag :content, "Note" %><%= text_area_tag :content, nil, required: true, rows: 6 %></div><div class="dialog__actions"><button type="button" class="button" data-action="dialog#close">Cancel</button><%= submit_tag "Post note", class: "button button--primary" %></div><% end %></dialog>
</div>
