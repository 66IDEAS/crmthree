<% content_for :title, "Trends · CRMthree" %><div class="page"><header class="page-heading"><nav class="breadcrumb"><%= link_to "Home", root_path %> / Trends</nav><div><h1 class="page-title">CRM trends</h1><p class="page-subtitle">Six authorised monthly periods with explainable projections.</p></div></header><section class="dashboard-grid"><% @metrics.each do |metric| %><article class="panel dashboard-chart"><div class="panel__header"><h2><%= metric.label %></h2><span class="chip <%= metric.direction == "Up" ? "chip--positive" : "" %>"><%= metric.direction %></span></div><div class="settings-section__body"><div class="trend-values"><% @periods.zip(metric.values).each do |period, value| %><span><small><%= period %></small><strong><%= number_with_delimiter(value) %></strong></span><% end %></div><p><strong>Next projection: <%= number_with_delimiter(metric.projection) %></strong></p><p class="field-hint"><%= metric.explanation %></p></div></article><% end %></section></div>
