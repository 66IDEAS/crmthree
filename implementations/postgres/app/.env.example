# Application connection. Must NOT be the database owner: owners are exempt from row level
# security, which would silently disable every policy.
DATABASE_URL=postgresql://crm_app@localhost:5432/crmthree_local

# Owner connection, used only for migrations and for creating the auth tables.
MIGRATION_DATABASE_URL=postgresql://youruser@localhost:5432/crmthree_local

# Session signing key. Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:5173

# Optional. Leave blank to run with email and password only.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Where uploaded files land. Bytes on disk, metadata in Document records.
FILE_STORAGE_DIR=data/files

# Encrypts the AI provider key held in ai_provider_config. Never stored in the database.
AI_KEY_ENCRYPTION_KEY=
